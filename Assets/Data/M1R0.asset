  m_Script: {fileID: 11500000, guid: e6be890c8a758f3488227c7687955d0c, type: 3}
  m_Name: M1R0
  m_EditorClassIdentifier: Assembly-CSharp::TaleStoneData
  DialogueLines:
  - textVI: "Nh\u1EEFng \u0111\u1EE9a tr\u1EBB h\u01B0 h\u1ECFng, n\u1EBFu nh\u01B0
      s\u1ED1 m\u1EC7nh \u0111\xE3 an b\xE0i,... c\u1EDB sao l\u1EA1i ph\u1EA3n ngh\u1ECBch
      \u0111\u1EC3 d\u1EABn \u0111\u1EBFn k\u1EBFt c\u1EE5c n\xE0y?"
    textEN: Wayward children, if destiny had already woven your paths... why rebel
      against the loom, only to meet such a wretched end?
    AutoSkip: 0
  - textVI: "Im mi\u1EC7ng! Ta, Vindi, kh\xF4ng tu\xE2n theo m\u1EC7nh!"
    textEN: Silence! I am Vindi, bow to no fate!
    AutoSkip: 0
  - textVI: "Ng\u01B0\u1EDDi kh\xF4ng v\xEC m\xECnh, tr\u1EDDi tru \u0111\u1EA5t
      di\u1EC7t, ta s\u1EBD ch\u1EE9ng minh con \u0111\u01B0\u1EDDng c\u1EE7a c\xE1c
      ti\u1EC1n b\u1ED1i l\xE0 \u0111\xFAng \u0111\u1EAFn!"
    textEN: Every soul for itself, or heaven and earth shall tear them asunder! I
      will vindicate the path of those who came before me!
    AutoSkip: 0
  AutoProgressDelay: 1.5
  TypingSpeed: 0.05
  IsActivated: 0
  IsKingMonolith: 0
  IsHeroMonolith: 0
