  m_Script: {fileID: 11500000, guid: e6be890c8a758f3488227c7687955d0c, type: 3}
  m_Name: KingMonolith
  m_EditorClassIdentifier: Assembly-CSharp::TaleStoneData
  DialogueLines:
  - textVI: "\u0110\u1EE9c Vua kh\xF4ng ch\u1EC9 th\u1ED1ng tr\u1ECB v\u01B0\u01A1ng
      qu\u1ED1c. Ng\u01B0\u1EDDi th\u1ED1ng tr\u1ECB c\u1EA3 l\xF2ng can \u0111\u1EA3m
      c\u1EE7a th\u1EA7n d\xE2n v\xE0 n\u1ED7i s\u1EE3 h\xE3i c\u1EE7a k\u1EBB th\xF9.\n"
    textEN: The King does not merely rule a kingdom. He rules the courage of his
      subjects and the terror of his enemies.
    AutoSkip: 0
  - textVI: "Ch\u1EC9 c\u1EA7n c\xF2n nh\u1EDB v\u1EC1 Ng\u01B0\u1EDDi... v\u01B0\u01A1ng
      qu\u1ED1c n\xE0y s\u1EBD kh\xF4ng bao gi\u1EDD l\u1EE5i t\xE0n."
    textEN: As long as He is remembered... this kingdom will never fall.
    AutoSkip: 0
  AutoProgressDelay: 1.5
  TypingSpeed: 0.05
  IsActivated: 0
  IsKingMonolith: 1
  IsHeroMonolith: 0
