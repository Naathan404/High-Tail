  m_Script: {fileID: 11500000, guid: e6be890c8a758f3488227c7687955d0c, type: 3}
  m_Name: AirGlideUnlockTaleStone
  m_EditorClassIdentifier: Assembly-CSharp::TaleStoneData
  DialogueLines:
  - textVI: "Gi\xF3 \u1EDF ch\u1ED1n n\xE0y \u0111\xE3 ng\u1EE7 v\xF9i qu\xE1 l\xE2u,
      ch\u1EB3ng c\xF2n ai khi\xEAu v\u0169 c\xF9ng ch\xFAng n\u1EEFa."
    textEN: The wind here has slept for far too long, with none left to dance with
      it.
    AutoSkip: 0
  - textVI: "H\xE3y bung m\u1EDF chi\u1EBFc \u0111u\xF4i c\u1EE7a ng\u01B0\u01A1i
      ra, dang tay \u0111\xF3n l\u1EA5y lu\u1ED3ng kh\xED l\u1EA1nh, v\xE0 ch\xEDnh
      b\u1EA7u tr\u1EDDi s\u1EBD \u0111\u01B0a con v\u01B0\u1EE3t qua c\xF5i h\u01B0
      v\xF4."
    textEN: Spread your tail, embrace the cold updrafts, and the air itself will
      carry you across the void.
    AutoSkip: 0
  AutoProgressDelay: 1.5
  TypingSpeed: 0.05
  IsActivated: 0
  IsKingMonolith: 0
  IsHeroMonolith: 0
