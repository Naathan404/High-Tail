  m_Script: {fileID: 11500000, guid: e6be890c8a758f3488227c7687955d0c, type: 3}
  m_Name: WallJumpUnlockTaleStone
  m_EditorClassIdentifier: Assembly-CSharp::TaleStoneData
  DialogueLines:
  - textVI: "Con \u0111\u01B0\u1EDDng ph\xEDa tr\u01B0\u1EDBc \u0111\xE3 v\u1EE1
      v\u1EE5n, h\u1EE1i sinh linh b\xE9 nh\u1ECF."
    textEN: The path ahead is broken, little one.
    AutoSkip: 0
  - textVI: "Nh\u01B0ng ch\u01B0\u1EDBng ng\u1EA1i v\u1EADt ch\u1EC9 l\xE0 b\u1EC7
      ph\xF3ng cho nh\u1EEFng ai mang \u0111\xF4i ch\xE2n can tr\u01B0\u1EDDng."
    textEN: But obstacles are merely stepping stones for the swift.
    AutoSkip: 0
  - textVI: "H\xE3y n\u01B0\u01A1ng t\u1EF1a v\xE0o nh\u1EEFng v\xE1ch \u0111\xE1
      v\u1EEFng ch\xE3i, v\xE0 v\xFAt l\xEAn nh\u1EEFng t\u1EA7m cao m\u1EDBi."
    textEN: Push against the sturdy roots, and leap ever higher.
    AutoSkip: 0
  AutoProgressDelay: 1.5
  TypingSpeed: 0.05
