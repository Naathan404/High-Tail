  m_Script: {fileID: 11500000, guid: e6be890c8a758f3488227c7687955d0c, type: 3}
  m_Name: M1R1_1
  m_EditorClassIdentifier: Assembly-CSharp::TaleStoneData
  DialogueLines:
  - textVI: "Nh\xE0 t\xF9 c\u1EE7a nh\u1EEFng linh h\u1ED3n b\u1EA1i tr\u1EADn, n\u01A1i
      nh\u1EEFng l\xFD t\u01B0\u1EDFng \u0111ang d\u1EA7n b\u1ECB ch\xF4n v\xF9i
      sau m\xE0n s\u01B0\u01A1ng \u0111en."
    textEN: The prison of vanquished souls, where forsaken ideals lie buried beneath
      a shroud of black mist
    AutoSkip: 0
  - textVI: "\u1EDE \u0111\xE2y, kh\xF4ng c\xF2n \xE1nh m\u1EB7t tr\u1EDDi, kh\xF4ng
      c\xF2n hi v\u1ECDng, ch\u1EC9 c\xF2n \u0111\u1ECDng l\u1EA1i s\u1EF1 th\xF9
      h\u1EADn."
    textEN: "Where no sunlight dares reach, no hope remains to endure\u2014only hatred
      lingers in the hollow darkness."
    AutoSkip: 0
  - textVI: "V\u0129nh vi\u1EC5n, b\u1ECB l\u01B0u \u0111\xE0y!"
    textEN: All are condemned to eternal exile!
    AutoSkip: 0
  AutoProgressDelay: 1.5
  TypingSpeed: 0.05
  IsActivated: 0
  IsKingMonolith: 0
  IsHeroMonolith: 0
