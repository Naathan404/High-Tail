  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Lore_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 71878084ec7e2a546aff2c47cb7ae023, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 23628541952
    m_Localized: '"Since the dawn of time, the Light was the heartbeat of the ancient
      forest..."'
    m_Metadata:
      m_Items: []
  - m_Id: 1130383732736
    m_Localized: '"But then, the source fractured. Darkness slowly consumed the high
      canopy."'
    m_Metadata:
      m_Items: []
  - m_Id: 1274588098560
    m_Localized: '"One last fragment of light broke away, calling out into the fading
      void..."'
    m_Metadata:
      m_Items: []
  - m_Id: 1353659117568
    m_Localized: '"And a tiny creature, with its tail held high, bravely answered."'
    m_Metadata:
      m_Items: []
  - m_Id: 1262529072263168
    m_Localized: '"You have traversed the withered roots, leaving behind a resilient
      trail of light.'
    m_Metadata:
      m_Items: []
  - m_Id: 1268501605969920
    m_Localized: The deep slumber of this forest has begun to fade...
    m_Metadata:
      m_Items: []
  - m_Id: 1268571101392896
    m_Localized: Yet, your journey has only just begun.
    m_Metadata:
      m_Items: []
  - m_Id: 1268637874712576
    m_Localized: 'Rest for a moment, little spirit.

      Ahead... forgotten realms
      still yearn for your awakening touch."'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
