  m_TableData:
  - m_Id: 195560423424
    m_Localized: "B\u1EADt t\u01B0\u1EDDng"
    m_Metadata:
      m_Items: []
  - m_Id: 527195652096
    m_Localized: "Tr\u01B0\u1EE3t t\u01B0\u1EDDng"
    m_Metadata:
      m_Items: []
  - m_Id: 746167681024
    m_Localized: "L\u01B0\u1EDBt Gi\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 775271956480
    m_Localized: "Nh\u1EA5n [{0}] \u0111\u1EC3 l\u01B0\u1EDBt nhanh v\u1EC1 ph\xEDa
      tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items:
      - rid: 3040156929586364499
  - m_Id: 794670612480
    m_Localized: "L\u01B0\u1EE3n"
    m_Metadata:
      m_Items: []
  - m_Id: 847372042240
    m_Localized: "Khi \u0111ang \u1EDF tr\xEAn kh\xF4ng, gi\u1EEF [{0}] \u0111\u1EC3
      l\u01B0\u1EE3n t\u1EEB t\u1EEB xu\u1ED1ng."
    m_Metadata:
      m_Items:
      - rid: 3040156929586364499
  - m_Id: 927592300544
    m_Localized: "D\u1EADm \u0111u\xF4i"
    m_Metadata:
      m_Items: []
  - m_Id: 967249444864
    m_Localized: "Khi \u0111ang tr\xEAn kh\xF4ng, nh\u1EA5n [{0}] \u0111\u1EC3 d\u1EADm
      m\u1EA1nh xu\u1ED1ng. D\u1EADm tr\xFAng m\u1ED9t s\u1ED1 v\u1EADt th\u1EC3
      nh\u1EA5t \u0111\u1ECBnh s\u1EBD gi\xFAp b\u1EA1n b\u1EADt n\u1EA3y l\xEAn."
    m_Metadata:
      m_Items:
      - rid: 3040156929586364499
  - m_Id: 989965795328
    m_Localized: "Ph\xE1t quang"
    m_Metadata:
      m_Items: []
  - m_Id: 1052985212928
    m_Localized: "S\xF3ng \xE1nh s\xE1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 1209126567936
    m_Localized: "Gi\u1EA3i ph\xF3ng Xung N\u0103ng L\u01B0\u1EE3ng b\u1EB1ng ph\xEDm
      [{0}] \u0111\u1EC3 \u0111\xE1nh th\u1EE9c c\xE1c c\u01A1 quan \u1EA9n gi\u1EA5u.
      H\xE3y ch\xFA \xFD th\u1EDDi gian h\u1ED3i chi\xEAu sau m\u1ED7i l\u1EA7n s\u1EED
      d\u1EE5ng."
    m_Metadata:
      m_Items:
      - rid: 3040156929586364499
  - m_Id: 331829166080
    m_Localized: "Khi ch\u1EA1m t\u01B0\u1EDDng, nh\u1EA5n [{0}] \u0111\u1EC3 b\u1EADt
      nh\u1EA3y theo h\u01B0\u1EDBng ng\u01B0\u1EE3c l\u1EA1i."
    m_Metadata:
      m_Items:
      - rid: 3040156929586364499
  - m_Id: 663607001088
    m_Localized: "Gi\u1EEF h\u01B0\u1EDBng di chuy\u1EC3n v\u1EC1 ph\xEDa t\u01B0\u1EDDng
      \u0111\u1EC3 tr\u01B0\u1EE3t t\u1EEB t\u1EEB xu\u1ED1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 17220154435760128
    m_Localized: "B\xE1m d\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 17220425622679552
    m_Localized: "Khi ch\u1EA1m v\xE0o d\xE2y, gi\u1EEF [{0}] \u0111\u1EC3 b\xE1m
      l\u1EA5y n\xF3."
    m_Metadata:
      m_Items: []
