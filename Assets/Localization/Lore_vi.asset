  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Lore_vi
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: vi
  m_SharedData: {fileID: 11400000, guid: 71878084ec7e2a546aff2c47cb7ae023, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 23628541952
    m_Localized: "\"T\u1EEB thu\u1EDF s\u01A1 khai, \xC1nh S\xE1ng l\xE0 nh\u1ECBp
      \u0111\u1EADp c\u1EE7a c\u1ED9i r\u1EEBng gi\xE0...\""
    m_Metadata:
      m_Items: []
  - m_Id: 1130383732736
    m_Localized: "\"Nh\u01B0ng r\u1ED3i, ngu\u1ED3n c\u1ED9i r\u1EA1n n\u1EE9t. B\xF3ng
      t\u1ED1i t\u1EEB t\u1EEB nu\u1ED1t ch\u1EEDng nh\u1EEFng t\xE1n l\xE1 tr\xEAn
      cao.\""
    m_Metadata:
      m_Items: []
  - m_Id: 1274588098560
    m_Localized: "\"M\u1ED9t m\u1EA3nh s\xE1ng cu\u1ED1i c\xF9ng t\xE1ch ra, c\u1EA5t
      ti\u1EBFng g\u1ECDi l\u1ECBm d\u1EA7n trong v\xF4 v\u1ECDng...\""
    m_Metadata:
      m_Items: []
  - m_Id: 1353659117568
    m_Localized: "\"V\xE0 m\u1ED9t b\xF3ng h\xECnh nh\u1ECF b\xE9, v\u1EDBi chi\u1EBFc
      \u0111u\xF4i v\xFAt cao, \u0111\xE3 d\u0169ng c\u1EA3m \u0111\xE1p l\u1EDDi.\""
    m_Metadata:
      m_Items: []
  - m_Id: 1262529072263168
    m_Localized: "\"Con \u0111\xE3 \u0111i qua nh\u1EEFng r\u1EC5 c\xE2y t\xE0n \xFAa,
      \u0111\u1EC3 l\u1EA1i ph\xEDa sau m\u1ED9t v\u1EC7t s\xE1ng ki\xEAn c\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 1268501605969920
    m_Localized: "Gi\u1EA5c ng\u1EE7 d\xE0i c\u1EE7a khu r\u1EEBng n\u01A1i \u0111\xE2y
      \u0111\xE3 b\u1EAFt \u0111\u1EA7u v\u01A1i \u0111i \u0111\xF4i ph\u1EA7n..."
    m_Metadata:
      m_Items: []
  - m_Id: 1268571101392896
    m_Localized: "Nh\u01B0ng h\xE0nh tr\xECnh c\u1EE7a con ch\u1EC9 v\u1EEBa m\u1EDBi
      b\u1EAFt \u0111\u1EA7u."
    m_Metadata:
      m_Items: []
  - m_Id: 1268637874712576
    m_Localized: "H\xE3y ngh\u1EC9 ng\u01A1i m\u1ED9t ch\xFAt, h\u1EE1i sinh linh
      nh\u1ECF b\xE9.\nPh\xEDa tr\u01B0\u1EDBc... nh\u1EEFng v\xF9ng \u0111\u1EA5t
      b\u1ECB l\xE3ng qu\xEAn v\u1EABn \u0111ang m\u1ECFi m\xF2n ch\u1EDD \u0111\u1EE3i
      b\u01B0\u1EDBc ch\xE2n con.\""
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
