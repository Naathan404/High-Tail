  m_TableData:
  - m_Id: 23628541952
    m_Localized: "\"T\u1EEB thu\u1EDF s\u01A1 khai, \xC1nh S\xE1ng l\xE0 nh\u1ECBp
      \u0111\u1EADp c\u1EE7a c\u1ED9i r\u1EEBng gi\xE0...\""
    m_Metadata:
      m_Items: []
  - m_Id: 1130383732736
    m_Localized: "\"Nh\u01B0ng r\u1ED3i, ngu\u1ED3n c\u1ED9i r\u1EA1n n\u1EE9t. B\xF3ng
      t\u1ED1i t\u1EEB t\u1EEB nu\u1ED1t ch\u1EEDng nh\u1EEFng t\xE1n l\xE1 tr\xEAn
      cao.\""
    m_Metadata:
      m_Items: []
  - m_Id: 1274588098560
    m_Localized: "\"M\u1ED9t m\u1EA3nh s\xE1ng cu\u1ED1i c\xF9ng t\xE1ch ra, c\u1EA5t
      ti\u1EBFng g\u1ECDi l\u1ECBm d\u1EA7n trong v\xF4 v\u1ECDng...\""
    m_Metadata:
      m_Items: []
  - m_Id: 1353659117568
    m_Localized: "\"V\xE0 m\u1ED9t b\xF3ng h\xECnh nh\u1ECF b\xE9, v\u1EDBi chi\u1EBFc
      \u0111u\xF4i v\xFAt cao, \u0111\xE3 d\u0169ng c\u1EA3m \u0111\xE1p l\u1EDDi.\""
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
